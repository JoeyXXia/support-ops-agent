# Health and mock modes require no API key. Copy to .env for Vite overrides.
# Read by Vite on the server; never use VITE_* for secrets.
API_PROXY_TARGET=http://127.0.0.1:8000

# Day 3: server-side model selection. Store real credentials in ignored .env.local.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Day 8: store real DB credentials in ignored .env.database.local.
# No default connection and no dependency from /health or mock runs.
DATABASE_URL=
# Integration tests must use a dedicated database ending in _test.
TEST_DATABASE_URL=

# Day 16: opt in to PostgreSQL run persistence after alembic upgrade head.
SUPPORTOPS_PERSIST_RUNS=0

# Day 22: server-only JSON dictionary for all four seed users, distinct passwords >=12 chars.
# Set actual values in the backend process environment or ignored .env.local, never VITE_*.
SUPPORTOPS_DEMO_PASSWORDS=
# Enable only with HTTPS. Local HTTP demo uses 0.
SUPPORTOPS_COOKIE_SECURE=0

# Day 25: trusted local stdio launcher selects one seed subject; no default.
# This name is NOT a credential. Server reads the process environment, not dotenv files.
SUPPORTOPS_MCP_SUBJECT=

# Day 26: backend process configuration; direct (default) or mcp. Restart backend.
# Only workspace usage/errors use MCP; identity comes from the trusted session.
# This field cannot be set in run request bodies.
SUPPORTOPS_READ_TOOL_TRANSPORT=direct
