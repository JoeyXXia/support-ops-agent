# Health and mock modes require no API key. Copy to .env for Vite overrides.
# Read by Vite on the server; never use VITE_* for secrets.
API_PROXY_TARGET=http://127.0.0.1:8000

# Day 3: server-side model selection. Store real credentials in ignored .env.local.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
